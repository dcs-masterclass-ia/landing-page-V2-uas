{%- macro bullets(items, cls='') -%}
<div class="dot-list {{ cls }}" role="list">
{%- for b in items %}
  <div class="dot-item" role="listitem"><span class="dot" aria-hidden="true"></span><span>{{ b }}</span></div>
{%- endfor %}
</div>
{%- endmacro -%}
{%- macro social(net) -%}
{%- if net == 'facebook' -%}<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1 0 2 .1 2.2.1v2.6h-1.5c-1.2 0-1.4.6-1.4 1.4V12h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z"/></svg>
{%- elif net == 'x' -%}<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 3H21l-6.6 7.5L22 21h-6.4l-5-6.6L5.4 21H3.2l7-8-7.7-10H9l4.6 6.1L18.9 3z"/></svg>
{%- elif net == 'instagram' -%}<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>
{%- elif net == 'youtube' -%}<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 9l6 3-6 3V9z"/></svg>
{%- else -%}<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.3-.02-2.96-1.8-2.96-1.8 0-2.08 1.4-2.08 2.86V21h-4z"/></svg>
{%- endif -%}
{%- endmacro -%}
{%- set social_labels = {'facebook':'Facebook','x':'X','instagram':'Instagram','youtube':'YouTube','linkedin':'LinkedIn'} -%}
<!DOCTYPE html>
<html lang="{{ page.lang }}" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{{ page.meta.title }}</title>
  <meta name="description" content="{{ page.meta.description }}" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <link rel="canonical" href="{{ url }}" />
  <meta name="author" content="{{ page.meta.author }}" />
  <meta name="language" content="{{ page.lang }}" />
  <meta name="geo.region" content="{{ page.meta.geo_region }}" />
  <meta name="geo.country" content="{{ page.meta.geo_country }}" />
  {%- if page.meta.google_site_verification %}
  <meta name="google-site-verification" content="{{ page.meta.google_site_verification }}" />
  {%- endif %}
  {#- hreflang volontairement absent : cartographie des marches non disponible (decision du 2026-08-03) #}

  <meta property="og:title" content="{{ page.meta.title }}" />
  <meta property="og:description" content="{{ page.meta.description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="{{ page.locale }}" />
  <meta property="og:url" content="{{ url }}" />
  <meta property="og:site_name" content="{{ page.meta.site_name }}" />
  <meta property="og:image" content="{{ page.hero.image }}" />
  <meta property="og:image:alt" content="{{ page.meta.og_image_alt }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ page.meta.title }}" />
  <meta name="twitter:description" content="{{ page.meta.description }}" />
  <meta name="twitter:image" content="{{ page.hero.image }}" />

{%- for block in jsonld %}
  <script type="application/ld+json">
{{ block }}
  </script>
{%- endfor %}

  <style>
    /* TEMPLATE PEUGEOT V2 — systeme propre | accent {{ theme.accent }} | build {{ build_date }} */
    @font-face { font-family:'StellantisUI'; src:url('{{ tokens.font_src }}StellantisUI-Regular.ttf') format('truetype'); font-weight:400; font-style:normal; font-display:swap; }
    @font-face { font-family:'StellantisUI'; src:url('{{ tokens.font_src }}StellantisUI-Bold.ttf') format('truetype'); font-weight:700; font-style:normal; font-display:swap; }

    :root { --ink:{{ tokens.color_h1 }}; --paper:#FFFFFF; --greyline:#E3E3E3; --pblue:{{ theme.accent }}; --pblue2:#006FDE; --radius:{{ theme.radius_card }}; }
    *,*::before,*::after { box-sizing:border-box; margin:0; padding:0; border-radius:var(--radius) !important; }
    html { font-family:{{ tokens.font_stack }}; scroll-behavior:smooth; }
    body { background:var(--paper); color:var(--ink); overflow-x:hidden; -webkit-font-smoothing:antialiased; }
    img { display:block; max-width:100%; }
    a { text-decoration:none; color:inherit; }

    /* ACCESSIBILITE */
    .skip-link { position:absolute; left:-9999px; top:0; z-index:999; background:var(--ink); color:#fff; padding:12px 20px; font-weight:700; }
    .skip-link:focus { left:0; }
    a:focus-visible, button:focus-visible { outline:3px solid var(--pblue) !important; outline-offset:3px; }
    @media (prefers-reduced-motion: reduce) { html{scroll-behavior:auto;} *,*::before,*::after{transition-duration:.01ms !important;animation-duration:.01ms !important;} }

    .wrap { max-width:1280px; margin:0 auto; padding:0 24px; }

    /* HEADER */
    .header { position:sticky; top:0; z-index:50; background:#fff; border-bottom:1px solid var(--greyline); }
    .header-inner { max-width:1280px; margin:0 auto; padding:12px 24px; display:flex; align-items:center; justify-content:space-between; position:relative; }
    .back-btn { width:40px; height:40px; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.05); flex-shrink:0; }
    .back-btn:hover { background:rgba(0,0,0,.1); }
    .logo { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); }
    .logo img { height:40px; }
    .header-cta { background:var(--pblue); color:#fff; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; padding:12px 20px; flex-shrink:0; }
    .header-cta:hover { background:var(--pblue2); }

    /* BREADCRUMB */
    .breadcrumb { background:#fff; border-bottom:1px solid var(--greyline); }
    .breadcrumb-inner { max-width:1280px; margin:0 auto; padding:12px 24px; font-size:12px; color:rgba(0,0,0,.65); display:flex; align-items:center; gap:8px; }
    .breadcrumb-inner a:hover { color:#000; }
    .breadcrumb-inner .current { color:#000; font-weight:600; }

    /* HERO PLEIN CADRE */
    .hero { position:relative; min-height:80vh; display:flex; align-items:flex-end; }
    .hero-media { position:absolute; inset:0; }
    .hero-media img { width:100%; height:100%; object-fit:cover; }
    .hero-media::after { content:''; position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,.85), rgba(0,0,0,.25) 60%, transparent); }
    .hero-inner { position:relative; z-index:1; padding:0 24px 64px; max-width:660px; }
    .tag-pill { display:inline-block; background:var(--pblue); color:#fff; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; padding:6px 12px; margin-bottom:20px; }
    .hero h1 { font-size:clamp(2rem,5vw,3.75rem); font-weight:700; text-transform:uppercase; letter-spacing:-.02em; line-height:.95; margin-bottom:16px; color:#fff; }
    .hero .sub { color:rgba(255,255,255,.88); font-size:1rem; max-width:460px; margin-bottom:32px; }
    .hero-cta { display:inline-flex; align-items:center; gap:12px; background:var(--pblue); color:#fff; font-size:14px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; padding:16px 32px; width:fit-content; }
    .hero-cta:hover { background:var(--pblue2); }

    /* SOUS-NAV ANCREE (maillage interne) */
    .subnav { position:sticky; top:65px; z-index:40; background:#fff; border-bottom:1px solid var(--greyline); overflow-x:auto; }
    .subnav-inner { max-width:1280px; margin:0 auto; padding:0 24px; display:flex; gap:32px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; white-space:nowrap; }
    .subnav-inner a { padding:16px 0; display:inline-block; color:rgba(0,0,0,.7); }
    .subnav-inner a:hover { color:var(--pblue); }

    /* BANDEAU DE CONFIANCE */
    .stats-band { border-bottom:1px solid var(--greyline); background:#fff; }
    .stats-inner { max-width:1280px; margin:0 auto; display:grid; grid-template-columns:repeat(2,1fr); padding:40px 24px; gap:24px 0; }
    @media (min-width:768px){ .stats-inner{grid-template-columns:repeat(4,1fr);gap:0;} }
    .stats-inner > div { padding:0 24px; border-left:1px solid var(--greyline); }
    .stats-inner > div:first-child { border-left:none; padding-left:0; }
    .stat-num { font-size:clamp(1.1rem,2vw,1.5rem); font-weight:700; letter-spacing:-.02em; color:#000; line-height:1.2; }
    .stat-label { font-size:13px; color:rgba(0,0,0,.65); margin-top:4px; }

    /* SPLIT 50/50 */
    .split { display:grid; }
    @media (min-width:768px){ .split{grid-template-columns:1fr 1fr;} }
    .split-media { aspect-ratio:1/1; }
    @media (min-width:768px){ .split-media{aspect-ratio:auto;min-height:540px;} }
    .split-media img { width:100%; height:100%; object-fit:cover; }
    .split-content { display:flex; flex-direction:column; justify-content:center; padding:56px 24px; }
    @media (min-width:768px){ .split-content{padding:56px 64px;} }
    .split-content h2 { font-size:clamp(1.5rem,3.5vw,2.5rem); font-weight:700; text-transform:uppercase; letter-spacing:-.02em; line-height:1.15; margin-bottom:16px; color:#000; }
    .split-content p { font-size:14px; color:rgba(0,0,0,.7); line-height:1.7; margin-bottom:12px; }
    .split.reverse .split-media { order:1; }
    .split.reverse .split-content { order:2; }
    @media (min-width:768px){ .split.reverse .split-media{order:2;} .split.reverse .split-content{order:1;} }
    .eyebrow { display:inline-flex; align-items:center; gap:8px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:rgba(0,0,0,.7); margin-bottom:16px; }
    .eyebrow::before { content:''; width:18px; height:2px; background:var(--pblue); display:inline-block; flex-shrink:0; }

    /* LISTES */
    .dot-list { display:flex; flex-direction:column; gap:12px; margin-top:8px; }
    .dot-item { display:flex; align-items:flex-start; gap:12px; font-size:14px; line-height:1.7; color:rgba(0,0,0,.7); }
    .dot { width:8px; height:8px; background:var(--pblue); flex-shrink:0; margin-top:7px; }
    .dot-list.on-dark .dot-item { color:rgba(255,255,255,.85); }

    /* ETAPES */
    .steps-section { max-width:1280px; margin:0 auto; padding:64px 24px; }
    .steps-head { max-width:660px; margin-bottom:48px; }
    .steps-head h2 { font-size:clamp(1.5rem,3.5vw,2.5rem); font-weight:700; text-transform:uppercase; letter-spacing:-.02em; line-height:1.15; color:#000; }
    .steps-grid { display:grid; gap:32px; }
    @media (min-width:768px){ .steps-grid{grid-template-columns:repeat(3,1fr);} }
    .step-item { border-top:2px solid var(--pblue); padding-top:16px; }
    .step-num { font-size:2.25rem; font-weight:700; color:var(--pblue); margin-bottom:12px; line-height:1; }
    .step-item h3 { font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:-.01em; margin-bottom:8px; color:#000; }
    .step-item p { font-size:13px; color:rgba(0,0,0,.7); line-height:1.7; margin-bottom:10px; }
    .step-pill { display:inline-block; margin-top:8px; font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--pblue); background:rgba(0,116,232,.08); padding:4px 10px; }

    /* BLOC SOMBRE (comparatif / cote) */
    .dark-block { position:relative; min-height:70vh; display:flex; align-items:center; }
    .dark-media { position:absolute; inset:0; }
    .dark-media img { width:100%; height:100%; object-fit:cover; }
    .dark-media::after { content:''; position:absolute; inset:0; background:rgba(0,0,0,.78); }
    .dark-inner { position:relative; z-index:1; max-width:1280px; margin:0 auto; padding:64px 24px; display:grid; gap:40px; }
    @media (min-width:768px){ .dark-inner{grid-template-columns:1fr 1fr;} }
    .dark-inner h2 { color:#fff; font-size:clamp(1.5rem,3.5vw,2.5rem); font-weight:700; text-transform:uppercase; letter-spacing:-.02em; line-height:1.15; }
    .dark-inner .eyebrow { color:rgba(255,255,255,.8); }
    .dark-text { display:flex; flex-direction:column; justify-content:center; }
    .dark-text p { color:rgba(255,255,255,.8); font-size:14px; line-height:1.7; margin-bottom:12px; }
    .compare-label { display:block; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; margin:0 0 12px; }
    .compare-label.positive { color:var(--pblue); }
    .compare-label.negative { color:rgba(255,255,255,.65); }
    .compare-block { margin-bottom:28px; }
    .dot-list.muted .dot { background:rgba(255,255,255,.35); }
    .dark-closing { margin-top:8px; color:#fff; font-weight:700; font-size:1rem; }

    /* FAQ */
    .faq-section { max-width:1280px; margin:0 auto; padding:64px 24px; }
    .faq-head { margin-bottom:40px; }
    .faq-head h2 { font-size:clamp(1.5rem,3.5vw,2.5rem); font-weight:700; text-transform:uppercase; letter-spacing:-.02em; color:#000; }
    .faq-row { display:grid; gap:16px; padding:24px 0; border-bottom:1px solid var(--greyline); }
    @media (min-width:768px){ .faq-row{grid-template-columns:1fr 1.4fr;gap:40px;} }
    .faq-row h3 { font-size:1rem; font-weight:700; color:#000; }
    .faq-row p { font-size:14px; color:rgba(0,0,0,.7); line-height:1.7; margin-bottom:10px; }

    /* CTA FINAL */
    .final-cta-wrap { max-width:1280px; margin:0 auto; padding:0 24px 64px; }
    .final-cta { background:#000; color:#fff; text-align:center; padding:64px 24px; }
    .final-cta .eyebrow { color:rgba(255,255,255,.8); justify-content:center; }
    .final-cta .eyebrow::before { background:var(--pblue); }
    .final-cta h2 { font-size:clamp(1.5rem,3vw,2rem); font-weight:700; text-transform:uppercase; letter-spacing:-.02em; margin-bottom:12px; color:#fff; }
    .final-cta p { color:rgba(255,255,255,.75); font-size:14px; margin-bottom:32px; }
    .final-cta-btn { display:inline-flex; background:var(--pblue); color:#fff; font-size:14px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; padding:16px 32px; }
    .final-cta-btn:hover { background:var(--pblue2); }

    /* FOOTER */
    .footer { background:#000; color:rgba(255,255,255,.7); padding:64px 24px 32px; }
    .footer-inner { max-width:1280px; margin:0 auto; }
    .footer-grid { display:grid; gap:40px; margin-bottom:48px; }
    @media (min-width:768px){ .footer-grid{grid-template-columns:repeat(4,1fr);} }
    .footer-col-title { font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:#fff; margin-bottom:20px; padding-bottom:12px; border-bottom:1px solid rgba(255,255,255,.15); }
    .footer-links { display:flex; flex-direction:column; gap:12px; font-size:14px; }
    .footer-links a { color:rgba(255,255,255,.72); }
    .footer-links a:hover { color:#fff; text-decoration:underline; }
    .footer-brand img { height:36px; filter:brightness(0) invert(1); margin-bottom:16px; }
    .footer-tagline { font-size:14px; color:rgba(255,255,255,.72); line-height:1.6; margin-bottom:20px; }
    .footer-social { display:flex; gap:12px; flex-wrap:wrap; }
    .footer-social a { width:36px; height:36px; background:var(--pblue); display:flex; align-items:center; justify-content:center; color:#fff; }
    .footer-social a:hover { background:var(--pblue2); }
    .footer-legal { border-top:1px solid rgba(255,255,255,.14); padding-top:24px; margin-bottom:20px; font-size:12px; line-height:1.6; color:rgba(255,255,255,.78); }
    /* CORRECTIF CONTRASTE : opacites remontees pour WCAG AA 4.5:1 */
    .footer-eco { border-top:1px solid rgba(255,255,255,.14); padding-top:24px; text-align:center; font-size:12px; color:rgba(255,255,255,{{ tokens.footer_opacity_eco }}); }
    .footer-eco a { color:rgba(255,255,255,.8); text-decoration:underline; }
    .footer-year { text-align:center; padding-top:16px; font-size:12px; color:rgba(255,255,255,{{ tokens.footer_opacity_year }}); }

    @media (max-width:767px){
      .hero{min-height:65vh;}
      .hero-inner{padding:0 16px 48px;}
      .subnav{top:61px;}
      .subnav-inner{gap:24px;padding:0 16px;}
      .header-inner,.breadcrumb-inner{padding-left:16px;padding-right:16px;}
      .header-cta{display:none;}
      .logo img{height:32px;}
      .steps-section,.faq-section{padding:40px 16px;}
      .final-cta{padding:40px 20px;}
      .footer{padding:48px 16px 24px;}
    }
  </style>
</head>
<body>

<a href="#main-content" class="skip-link">Acc&eacute;der au contenu principal</a>

<header class="header">
  <div class="header-inner">
    <a href="{{ page.domain }}/" class="back-btn" aria-label="Retour &agrave; l'accueil">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
    </a>
    <a href="{{ page.domain }}" class="logo" aria-label="{{ theme.label }} &mdash; Accueil">
      <img src="{{ page.header.logo }}" alt="{{ page.header.logo_alt }}" />
    </a>
    <a href="{{ page.header.cta_href }}" class="header-cta">{{ page.header.cta_label }}</a>
  </div>
</header>

<nav class="breadcrumb" aria-label="Fil d'Ariane">
  <div class="breadcrumb-inner">
    {%- for c in page.breadcrumb %}
    {%- if c.href %}<a href="{{ c.href }}">{{ c.label }}</a><span aria-hidden="true">/</span>
    {%- else %}<span class="current" aria-current="page">{{ c.label }}</span>{% endif %}
    {%- endfor %}
  </div>
</nav>

<main id="main-content">

  <section class="hero">
    <div class="hero-media" aria-hidden="true"><img src="{{ page.hero.image }}" alt="" loading="eager" /></div>
    <div class="hero-inner">
      <div class="tag-pill">{{ page.hero.tag }}</div>
      <h1>{{ page.hero.h1 }}</h1>
      <p class="sub">{{ page.hero.lead }}</p>
      <a href="{{ page.hero.cta_href }}" class="hero-cta">{{ page.hero.cta_label }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </section>

  <nav class="subnav" aria-label="Sommaire de la page">
    <div class="subnav-inner">
      {%- for s in page.subnav %}
      <a href="{{ s.anchor }}">{{ s.label }}</a>
      {%- endfor %}
    </div>
  </nav>

  <section class="stats-band">
    <div class="stats-inner">
      {%- for t in page.trust %}
      <div>
        <div class="stat-num">{{ t.label }}</div>
        <p class="stat-label">{{ t.sub }}</p>
      </div>
      {%- endfor %}
    </div>
  </section>

{%- for b in page.blocks %}
{%- if b.type == 'two_col' %}
  <section class="split {{ 'reverse' if b.image_side != 'left' }}" id="{{ b.id }}" aria-labelledby="{{ b.id }}-h2">
    <div class="split-media"><img src="{{ b.image }}" alt="{{ b.image_alt }}" loading="lazy" /></div>
    <div class="split-content">
      <div class="eyebrow">{{ b.tag }}</div>
      <h2 id="{{ b.id }}-h2">{{ b.h2 }}</h2>
      {%- for p in b.paragraphs %}<p>{% if p.strong %}<strong>{{ p.text }}</strong>{% else %}{{ p.text }}{% endif %}</p>{% endfor %}
      {%- if b.bullets %}{{ bullets(b.bullets) }}{% endif %}
      {%- for p in b.paragraphs_after %}<p style="margin-top:16px;">{{ p.text }}</p>{% endfor %}
      {%- if b.callout %}<div style="margin-top:24px;border-top:2px solid var(--pblue);padding-top:16px;"><h3 style="font-size:13px;font-weight:700;text-transform:uppercase;margin-bottom:8px;">{{ b.callout.h3 }}</h3><p>{{ b.callout.text }}</p></div>{% endif %}
    </div>
  </section>
{%- elif b.type == 'cote' %}
  <section class="dark-block" id="{{ b.id }}" aria-labelledby="{{ b.id }}-h2">
    <div class="dark-media" aria-hidden="true"><img src="{{ b.image }}" alt="" loading="lazy" /></div>
    <div class="dark-inner">
      <div>
        <div class="eyebrow">{{ b.tag }}</div>
        <h2 id="{{ b.id }}-h2">{{ b.h2 }}</h2>
      </div>
      <div class="dark-text">
        {%- for p in b.paragraphs %}<p>{{ p }}</p>{% endfor %}
        {%- if b.bullets %}{{ bullets(b.bullets, 'on-dark') }}{% endif %}
      </div>
    </div>
  </section>
{%- elif b.type == 'etapes' %}
  <section id="{{ b.id }}" aria-labelledby="{{ b.id }}-h2">
    <div class="steps-section">
      <div class="steps-head">
        <div class="eyebrow">{{ b.tag }}</div>
        <h2 id="{{ b.id }}-h2">{{ b.h2 }}</h2>
      </div>
      <div class="steps-grid">
        {%- for s in b.steps %}
        <div class="step-item" id="etape-{{ loop.index }}">
          <div class="step-num" aria-hidden="true">{{ '%02d'|format(loop.index) }}</div>
          <h3>{{ s.h3 }}</h3>
          {%- for p in s.paragraphs %}<p>{{ p }}</p>{% endfor %}
          {%- if s.pill %}<span class="step-pill">{{ s.pill }}</span>{% endif %}
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>
{%- elif b.type == 'comparatif' %}
  <section class="dark-block" id="{{ b.id }}" aria-labelledby="{{ b.id }}-h2">
    <div class="dark-media" aria-hidden="true"><img src="{{ b.image }}" alt="" loading="lazy" /></div>
    <div class="dark-inner">
      <div>
        <div class="eyebrow">{{ b.tag }}</div>
        <h2 id="{{ b.id }}-h2">{{ b.h2 }}</h2>
      </div>
      <div class="dark-text">
        <div class="compare-block">
          <span class="compare-label negative">{{ b.col_negative.label }}</span>
          {{ bullets(b.col_negative['items'], 'on-dark muted') }}
        </div>
        <div class="compare-block">
          <span class="compare-label positive">{{ b.col_positive.label }}</span>
          {{ bullets(b.col_positive['items'], 'on-dark') }}
        </div>
        <p class="dark-closing">{{ b.closing }}</p>
      </div>
    </div>
  </section>
{%- elif b.type == 'faq' %}
  <section id="{{ b.id }}" aria-labelledby="{{ b.id }}-h2">
    <div class="faq-section">
      <div class="faq-head">
        <div class="eyebrow">{{ b.tag }}</div>
        <h2 id="{{ b.id }}-h2">{{ b.h2 }}</h2>
      </div>
      <div>
        {%- for it in b['items'] %}
        <div class="faq-row">
          <h3>{{ it.q }}</h3>
          <div>
            {%- for p in it.paragraphs %}<p>{{ p }}</p>{% endfor %}
            {%- if it.bullets %}{{ bullets(it.bullets) }}{% endif %}
            {%- for p in it.paragraphs_after %}<p style="margin-top:12px;">{{ p }}</p>{% endfor %}
          </div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>
{%- endif %}
{%- endfor %}

  <div class="final-cta-wrap">
    <div class="final-cta">
      <div class="eyebrow">{{ page.cta_final.tag }}</div>
      <h2>{{ page.cta_final.h2 }}</h2>
      <p>{{ page.cta_final.lead }}</p>
      <a href="{{ page.cta_final.cta_href }}" class="final-cta-btn">{{ page.cta_final.cta_label }}</a>
    </div>
  </div>

</main>

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div>
        <div class="footer-brand"><img src="{{ page.header.logo }}" alt="{{ page.header.logo_alt }}" /></div>
        <p class="footer-tagline">{{ page.footer.tagline }}</p>
        <div class="footer-social">
          {%- for s in page.footer.social %}
          <a href="{{ s.href }}" aria-label="{{ social_labels.get(s.network, s.network) }}">{{ social(s.network) }}</a>
          {%- endfor %}
        </div>
      </div>
      {%- for col in page.footer.columns %}
      <div>
        <div class="footer-col-title">{{ col.title }}</div>
        <div class="footer-links">
          {%- for l in col.links %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor %}
        </div>
      </div>
      {%- endfor %}
    </div>
    <div class="footer-legal">{{ page.footer.legal }}</div>
    <div class="footer-eco">{{ page.footer.eco }} <a href="{{ page.footer.eco_link_href }}">{{ page.footer.eco_link_label }}</a></div>
    <div class="footer-year">{{ page.footer.year }}</div>
  </div>
</footer>

</body>
</html>
