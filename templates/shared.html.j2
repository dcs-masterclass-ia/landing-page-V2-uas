{%- macro icon(name) -%}
{%- if name == 'check' -%}<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
{%- elif name == 'mail' -%}<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
{%- elif name == 'clock' -%}<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
{%- elif name == 'agenda' -%}<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
{%- elif name == 'user' -%}<path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
{%- elif name == 'lock' -%}<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
{%- else -%}<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
{%- endif -%}
{%- endmacro -%}
{%- macro social(net) -%}
{%- if net == 'facebook' -%}<svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1 0 2 .1 2.2.1v2.6h-1.5c-1.2 0-1.4.6-1.4 1.4V12h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z"/></svg>
{%- elif net == 'x' -%}<svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 3H21l-6.6 7.5L22 21h-6.4l-5-6.6L5.4 21H3.2l7-8-7.7-10H9l4.6 6.1L18.9 3z"/></svg>
{%- elif net == 'instagram' -%}<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>
{%- elif net == 'youtube' -%}<svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 9l6 3-6 3V9z"/></svg>
{%- else -%}<svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.3-.02-2.96-1.8-2.96-1.8 0-2.08 1.4-2.08 2.86V21h-4z"/></svg>
{%- endif -%}
{%- endmacro -%}
{%- macro bullets(items) -%}
<div class="avantages-list" role="list">
{%- for b in items %}
  <div class="avantage-item" role="listitem"><span class="avantage-dot" aria-hidden="true"></span><span>{{ b }}</span></div>
{%- endfor %}
</div>
{%- endmacro -%}
{%- set social_labels = {'facebook':'Facebook','x':'X','instagram':'Instagram','youtube':'YouTube','linkedin':'LinkedIn'} -%}
<!DOCTYPE html>
<html lang="{{ page.lang }}" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{{ page.meta.title }}</title>
  <meta name="description" content="{{ page.meta.description }}" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <link rel="canonical" href="{{ url }}" />
  <meta name="author" content="{{ page.meta.author }}" />
  <meta name="language" content="{{ page.lang }}" />
  <meta name="geo.region" content="{{ page.meta.geo_region }}" />
  <meta name="geo.country" content="{{ page.meta.geo_country }}" />
  {%- if page.meta.google_site_verification %}
  <meta name="google-site-verification" content="{{ page.meta.google_site_verification }}" />
  {%- endif %}
  {#- hreflang volontairement absent : cartographie des marches non disponible (decision du 2026-08-03) #}

  <meta property="og:title" content="{{ page.meta.title }}" />
  <meta property="og:description" content="{{ page.meta.description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="{{ page.locale }}" />
  <meta property="og:url" content="{{ url }}" />
  <meta property="og:site_name" content="{{ page.meta.site_name }}" />
  <meta property="og:image" content="{{ page.hero.image }}" />
  <meta property="og:image:alt" content="{{ page.meta.og_image_alt }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ page.meta.title }}" />
  <meta name="twitter:description" content="{{ page.meta.description }}" />
  <meta name="twitter:image" content="{{ page.hero.image }}" />

{%- for block in jsonld %}
  <script type="application/ld+json">
{{ block }}
  </script>
{%- endfor %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    /* TEMPLATE PARTAGE V2 — {{ theme.label }} | accent {{ theme.accent }} | build {{ build_date }} */
    @font-face { font-family:'StellantisUI'; src:url('{{ tokens.font_src }}StellantisUI-Regular.ttf') format('truetype'); font-weight:400; font-style:normal; font-display:swap; }
    @font-face { font-family:'StellantisUI'; src:url('{{ tokens.font_src }}StellantisUI-Bold.ttf') format('truetype'); font-weight:700; font-style:normal; font-display:swap; }

    *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; border:0 !important; outline:none !important; }
    img { max-width:100%; display:block; }

    :root {
      --color-h1:{{ tokens.color_h1 }}; --color-text:{{ tokens.color_text }};
      --color-accent:{{ theme.accent }}; --accent-text:{{ theme.accent_text }}; --color-pastel:{{ tokens.color_pastel }};
      --glass-bg:rgba(255,255,255,0.85); --glass-blur:blur(40px);
      --shadow-diffuse:0 24px 48px rgba(17,24,39,0.04);
      --radius-card:{{ theme.radius_card }}; --radius-cta:{{ theme.radius_cta }};
      --font-main:{{ tokens.font_stack }};
    }

    html { scroll-behavior:smooth; }
    body { font-family:var(--font-main); background-color:{{ tokens.color_bg }}; color:var(--color-text); line-height:1.6; -webkit-font-smoothing:antialiased; overflow-x:hidden; }

    /* ACCESSIBILITE */
    .skip-link { position:absolute; left:-9999px; top:0; z-index:999; background:var(--color-h1); color:#fff; padding:12px 20px; font-weight:700; text-decoration:none; }
    .skip-link:focus { left:0; }
    a:focus-visible, button:focus-visible { outline:3px solid var(--color-accent) !important; outline-offset:3px; }
    @media (prefers-reduced-motion: reduce) { html{scroll-behavior:auto;} *,*::before,*::after{transition-duration:.01ms !important;animation-duration:.01ms !important;} }

    h1 { font-weight:900; letter-spacing:-.03em; font-size:clamp(1.75rem,2.8vw,2.75rem); color:var(--color-h1); line-height:1.1; margin-bottom:20px; }
    h2 { font-weight:800; letter-spacing:-.02em; font-size:clamp(1.375rem,2vw,2rem); color:var(--color-h1); line-height:1.2; margin-bottom:16px; }
    h3 { font-weight:700; letter-spacing:-.01em; font-size:1.125rem; color:var(--color-h1); margin-bottom:10px; }
    p { color:var(--color-text); font-size:.9375rem; margin-bottom:14px; }
    p:last-child { margin-bottom:0; }

    .section-tag { display:inline-flex; align-items:center; justify-content:center; width:fit-content; font-size:.75rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:var(--color-text); background:rgba(17,24,39,.05); padding:6px 14px; border-radius:var(--radius-cta); margin-bottom:24px !important; }
    .glass-card { background:var(--glass-bg); backdrop-filter:var(--glass-blur); -webkit-backdrop-filter:var(--glass-blur); border-radius:var(--radius-card); box-shadow:var(--shadow-diffuse); padding:40px; position:relative; overflow:hidden; }
    .callout-block { background:var(--color-pastel); border-radius:var(--radius-card); padding:32px; box-shadow:none !important; }
    .btn-primary { display:inline-flex; align-items:center; justify-content:center; gap:12px; background:var(--color-accent); color:var(--accent-text); font-size:.9375rem; font-weight:700; padding:16px 32px; border-radius:var(--radius-cta); text-decoration:none; transition:transform .2s ease,background .2s ease; cursor:pointer; font-family:var(--font-main); }
    .btn-primary:hover { filter:brightness(0.88); transform:translateY(-2px); }
    .btn-primary svg { width:18px; height:18px; }

    .container { max-width:1280px; margin:0 auto; padding-left:24px; padding-right:24px; }
    section { padding-top:64px; padding-bottom:64px; }

    /* HEADER */
    .site-header { position:sticky; top:0; z-index:500; background:#fff; border-top:3px solid var(--color-accent) !important; border-bottom:1px solid rgba(17,24,39,.06) !important; }
    .site-header-inner { max-width:1280px; margin:0 auto; padding:14px 24px; display:flex; align-items:center; justify-content:space-between; position:relative; }
    .site-logo { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); }
    .site-logo img { height:44px; width:auto; }
    .back-btn { background:rgba(17,24,39,.05); border-radius:10px; width:40px; height:40px; display:flex; align-items:center; justify-content:center; color:var(--color-h1); text-decoration:none; flex-shrink:0; }
    .back-btn:hover { background:rgba(17,24,39,.1); }
    .back-btn svg { width:18px; height:18px; }
    .header-cta { display:inline-flex; align-items:center; background:var(--color-accent); color:var(--accent-text); font-size:.8125rem; font-weight:700; padding:12px 22px; border-radius:var(--radius-cta); white-space:nowrap; text-decoration:none; font-family:var(--font-main); flex-shrink:0; }
    .header-cta:hover { filter:brightness(0.88); }

    /* BREADCRUMB */
    .breadcrumb-wrap { background:#fff; border-bottom:1px solid rgba(17,24,39,.05) !important; }
    .breadcrumb-inner { max-width:1280px; margin:0 auto; padding:12px 24px; font-size:.8125rem; display:flex; align-items:center; gap:8px; }
    .breadcrumb-inner a { color:var(--color-text); text-decoration:none; opacity:.7; }
    .breadcrumb-inner a:hover { opacity:1; text-decoration:underline; }
    .breadcrumb-sep { opacity:.4; }
    .breadcrumb-current { color:var(--color-h1); font-weight:600; }

    /* SOUS-NAV ANCREE (maillage interne) */
    .subnav { position:sticky; top:69px; z-index:400; background:#fff; border-bottom:1px solid rgba(17,24,39,.06) !important; overflow-x:auto; }
    .subnav-inner { max-width:1280px; margin:0 auto; padding:0 24px; display:flex; gap:32px; font-size:.75rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; white-space:nowrap; }
    .subnav-inner a { padding:16px 0; display:inline-block; color:var(--color-text); text-decoration:none; }
    .subnav-inner a:hover { color:var(--color-h1); }

    /* HERO */
    .hero { position:relative; padding:100px 0 72px; min-height:80vh; display:flex; align-items:flex-end; border-radius:0 0 var(--radius-card) var(--radius-card); overflow:hidden; }
    .hero-bg { position:absolute; inset:0; z-index:0; }
    .hero-bg img { width:100%; height:100%; object-fit:cover; object-position:center 40%; }
    .hero-bg::after { content:''; position:absolute; inset:0; background:linear-gradient(135deg,rgba(255,255,255,.98) 0%,rgba(255,255,255,.6) 45%,rgba(0,0,0,0) 100%); }
    .hero-content { position:relative; z-index:1; max-width:560px; padding:0 24px 64px 64px; margin-right:auto; }

    /* TRUST */
    .trust-section { padding:40px 0 72px; }
    .trust-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:20px; }
    .trust-card { padding:28px; display:flex; flex-direction:column; gap:14px; }
    .trust-icon { width:44px; height:44px; background:rgba(17,24,39,.05); border-radius:12px; display:flex; align-items:center; justify-content:center; color:var(--color-h1); }
    .trust-label { font-weight:800; color:var(--color-h1); font-size:1rem; }
    .trust-sub { font-size:.8125rem; color:var(--color-text); }

    /* TWO COL */
    .two-col { display:grid; grid-template-columns:1fr; gap:56px; align-items:center; }
    @media (min-width:1024px){ .two-col{grid-template-columns:1fr 1fr;} .two-col-img.left{order:-1;} }
    .two-col-img { border-radius:var(--radius-card); overflow:hidden; aspect-ratio:4/3; box-shadow:var(--shadow-diffuse); }
    .two-col-img img { width:100%; height:100%; object-fit:cover; }

    /* LISTES */
    .avantages-list { display:flex; flex-direction:column; gap:14px; }
    .avantage-item { display:flex; align-items:flex-start; gap:12px; font-size:.9375rem; line-height:1.6; }
    .avantage-dot { width:8px; height:8px; background:var(--color-accent); border-radius:50%; flex-shrink:0; margin-top:6px; }

    /* COTE (fond image sombre) */
    .cote-section { position:relative; overflow:hidden; border-radius:var(--radius-card); }
    .cote-bg { position:absolute; inset:0; z-index:0; background:var(--color-h1); }
    .cote-bg img { width:100%; height:100%; object-fit:cover; filter:grayscale(10%); }
    .cote-bg::after { content:''; position:absolute; inset:0; background:linear-gradient(to right,rgba(17,24,39,.95) 40%,rgba(17,24,39,.5) 70%,rgba(17,24,39,.1) 100%); }
    .cote-content { position:relative; z-index:1; padding:72px 64px; max-width:720px; }
    .cote-content .section-tag { background:rgba(255,255,255,.12); color:#fff; }
    .cote-content h2 { color:#fff; }
    .cote-content p, .cote-content .avantage-item { color:rgba(255,255,255,.85); }

    /* ETAPES */
    .etapes-wrap.dark { background:var(--color-h1); border-radius:var(--radius-card); padding:56px; }
    .etapes-wrap.dark .section-tag { background:rgba(255,255,255,.12); color:#fff; }
    .etapes-wrap.dark h2 { color:#fff; }
    .etapes-head { margin-bottom:40px; }
    .etapes-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px; }
    .etape-card { padding:32px; position:relative; overflow:hidden; border-radius:var(--radius-card); }
    .etapes-wrap.dark .etape-card { background:rgba(255,255,255,.05); }
    .etapes-wrap.light .etape-card { background:var(--glass-bg); box-shadow:var(--shadow-diffuse); padding:40px; }
    .etape-card-bg { position:absolute; top:0; right:0; width:50%; height:100%; pointer-events:none; z-index:0; }
    .etape-card-bg img { width:100%; height:100%; object-fit:cover; filter:grayscale(100%); opacity:.06; }
    .etape-card-content { position:relative; z-index:1; }
    .etape-num { font-size:3rem; font-weight:900; letter-spacing:-.05em; line-height:1; margin-bottom:20px; }
    .etapes-wrap.dark .etape-num { color:rgba(255,255,255,.10); }
    .etapes-wrap.light .etape-num { color:rgba(17,24,39,.06); }
    .etapes-wrap.dark .etape-card h3 { color:#fff; font-size:1rem; }
    .etapes-wrap.dark .etape-card p { color:rgba(255,255,255,.75); font-size:.8125rem; line-height:1.7; }
    .etape-pill { display:inline-block; margin-top:12px; font-size:.65rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; padding:4px 10px; border-radius:var(--radius-cta); }
    .etapes-wrap.dark .etape-pill { color:rgba(255,255,255,.75); background:rgba(255,255,255,.10); }
    .etapes-wrap.light .etape-pill { color:var(--color-text); background:rgba(17,24,39,.05); }

    /* COMPARATIF */
    .securite-wrap { background:var(--color-h1); border-radius:var(--radius-card); overflow:hidden; display:grid; grid-template-columns:1fr; }
    @media (min-width:1024px){ .securite-wrap{grid-template-columns:1fr 1fr;} }
    .securite-content { padding:64px; display:flex; flex-direction:column; justify-content:center; }
    .securite-content h2 { color:#fff; margin-bottom:20px; }
    .securite-content .section-tag { background:rgba(255,255,255,.12); color:#fff; }
    .compare-col { margin-bottom:32px; }
    .compare-col:last-of-type { margin-bottom:0; }
    .compare-label { font-size:.75rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; margin-bottom:16px; display:block; }
    .compare-label.positive { color:var(--color-accent); }
    .compare-label.negative { color:rgba(255,255,255,.6); }
    .compare-list { list-style:none; display:flex; flex-direction:column; gap:12px; }
    .compare-item { display:flex; align-items:flex-start; gap:16px; font-size:1rem; color:rgba(255,255,255,.88); font-weight:500; line-height:1.5; }
    .check-dot { width:8px; height:8px; background:var(--color-accent); border-radius:50%; flex-shrink:0; margin-top:8px; }
    .check-dot.muted { background:rgba(255,255,255,.3); }
    .securite-closing { margin-top:32px; font-size:1.125rem; font-weight:700; color:#fff; }
    .securite-visual { position:relative; overflow:hidden; min-height:400px; }
    .securite-visual img { width:100%; height:100%; object-fit:cover; filter:grayscale(15%); opacity:.85; }

    /* FAQ */
    .faq-grid { display:grid; grid-template-columns:1fr; gap:16px; max-width:900px; margin:0 auto; }

    /* CTA */
    .cta-final { background:var(--color-h1); border-radius:var(--radius-card); padding:72px 40px; text-align:center; }
    .cta-final h2, .cta-final p { color:#fff; }
    .cta-final .section-tag { background:rgba(255,255,255,.12); color:#fff; margin-left:auto; margin-right:auto; }
    .cta-final .btn-primary { background:#fff; color:var(--color-h1); margin-top:28px; }
    .cta-final .btn-primary:hover { background:var(--color-accent); color:#fff; }

    /* FOOTER */
    .site-footer { background:#000; color:rgba(255,255,255,.6); padding:64px 24px 32px; }
    .footer-inner { max-width:1280px; margin:0 auto; }
    .footer-grid { display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:40px; margin-bottom:48px; }
    .footer-brand { display:inline-flex; margin-bottom:16px !important; }
    .footer-brand img { height:40px; width:auto; filter:brightness(0) invert(1); }
    .footer-tagline { font-size:.9375rem; color:rgba(255,255,255,.7); line-height:1.6; max-width:320px; margin-bottom:24px; }
    .footer-social { display:flex; gap:12px; flex-wrap:wrap; }
    .footer-social a { width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,.08); display:flex; align-items:center; justify-content:center; color:#fff; }
    .footer-social a:hover { background:var(--color-accent); }
    .footer-social svg { width:16px; height:16px; }
    .footer-col-title { font-size:.8125rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:#fff; margin-bottom:20px; }
    .footer-links { display:flex; flex-direction:column; gap:14px; }
    .footer-links a { color:rgba(255,255,255,.65); text-decoration:none; font-size:.9375rem; }
    .footer-links a:hover { color:#fff; text-decoration:underline; }
    .footer-legal { border-top:1px solid rgba(255,255,255,.14) !important; padding-top:24px; margin-bottom:24px; font-size:.8125rem; line-height:1.6; }
    .footer-legal p { color:rgba(255,255,255,.78) !important; }
    /* CORRECTIF CONTRASTE : .45 -> {{ tokens.footer_opacity_eco }} (WCAG AA 4.5:1) */
    .footer-eco { border-top:1px solid rgba(255,255,255,.14) !important; padding-top:24px; text-align:center; font-size:.8125rem; color:rgba(255,255,255,{{ tokens.footer_opacity_eco }}); }
    .footer-eco a { color:rgba(255,255,255,.8); text-decoration:underline; }
    /* CORRECTIF CONTRASTE : .30 -> {{ tokens.footer_opacity_year }} (WCAG AA 4.5:1) */
    .footer-year { text-align:center; padding-top:16px; font-size:.75rem; color:rgba(255,255,255,{{ tokens.footer_opacity_year }}); }

    @media (max-width:768px){
      section{padding-top:40px;padding-bottom:40px;}
      .container{padding-left:16px;padding-right:16px;}
      .glass-card,.callout-block{padding:24px;}
      .hero{min-height:60vh;padding:72px 0 48px;}
      .hero-content{max-width:100%;padding:0 16px 48px 16px;}
      .hero-bg::after{background:linear-gradient(to bottom,rgba(255,255,255,.97) 0%,rgba(255,255,255,.85) 60%,rgba(255,255,255,.5) 100%);}
      .trust-grid{grid-template-columns:1fr 1fr;gap:12px;}
      .trust-card{padding:20px;gap:10px;}
      .cote-content{padding:40px 20px;}
      .etapes-wrap.dark{padding:32px 20px;}
      .securite-content{padding:36px 20px;}
      .cta-final{padding:40px 20px;}
      .header-cta{display:none;}
      .site-logo img{height:32px;}
      .site-header-inner,.breadcrumb-inner,.subnav-inner{padding-left:16px;padding-right:16px;}
      .subnav{top:61px;}
      .subnav-inner{gap:24px;}
      .footer-grid{grid-template-columns:1fr 1fr;gap:32px;}
      .site-footer{padding:48px 16px 24px;}
    }
    @media (max-width:520px){ .footer-grid{grid-template-columns:1fr;} }
  </style>
</head>
<body>

<a href="#main-content" class="skip-link">Acc&eacute;der au contenu principal</a>

<header class="site-header">
  <div class="site-header-inner">
    <a href="{{ page.domain }}/" class="back-btn" aria-label="Retour &agrave; l'accueil" target="_self">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
    </a>
    <a href="{{ page.domain }}" class="site-logo" aria-label="{{ theme.label }} &mdash; Accueil">
      <img src="{{ page.header.logo }}" alt="{{ page.header.logo_alt }}" />
    </a>
    <a href="{{ page.header.cta_href }}" class="header-cta">{{ page.header.cta_label }}</a>
  </div>
</header>

<nav class="breadcrumb-wrap" aria-label="Fil d'Ariane">
  <div class="breadcrumb-inner">
    {%- for c in page.breadcrumb %}
    {%- if c.href %}<a href="{{ c.href }}">{{ c.label }}</a><span class="breadcrumb-sep" aria-hidden="true">/</span>
    {%- else %}<span class="breadcrumb-current" aria-current="page">{{ c.label }}</span>{% endif %}
    {%- endfor %}
  </div>
</nav>

<main id="main-content">

  <header class="hero">
    <div class="hero-bg" aria-hidden="true"><img src="{{ page.hero.image }}" alt="" loading="eager" /></div>
    <div class="hero-content">
      <div class="section-tag">{{ page.hero.tag }}</div>
      <h1>{{ page.hero.h1 }}</h1>
      <p style="font-weight:500;margin-bottom:28px;">{{ page.hero.lead }}</p>
      <a href="{{ page.hero.cta_href }}" class="btn-primary">{{ page.hero.cta_label }}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </header>

  <nav class="subnav" aria-label="Sommaire de la page">
    <div class="subnav-inner">
      {%- for s in page.subnav %}
      <a href="{{ s.anchor }}">{{ s.label }}</a>
      {%- endfor %}
    </div>
  </nav>

  <div class="trust-section container">
    <div class="trust-grid">
      {%- for t in page.trust %}
      <div class="glass-card trust-card">
        <div class="trust-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="width:20px;">{{ icon(t.icon) }}</svg></div>
        <div><div class="trust-label">{{ t.label }}</div><div class="trust-sub">{{ t.sub }}</div></div>
      </div>
      {%- endfor %}
    </div>
  </div>

{%- for b in page.blocks %}
{%- if b.type == 'two_col' %}
  <section class="container" id="{{ b.id }}" aria-labelledby="{{ b.id }}-h2">
    <div class="two-col">
      {%- if b.image_side == 'left' %}
      {%- if b.image %}<div class="two-col-img left"><img src="{{ b.image }}" alt="{{ b.image_alt }}" loading="lazy" /></div>{% endif %}
      {%- endif %}
      <div>
        <div class="section-tag">{{ b.tag }}</div>
        <h2 id="{{ b.id }}-h2">{{ b.h2 }}</h2>
        {%- for p in b.paragraphs %}
        <p>{% if p.strong %}<strong>{{ p.text }}</strong>{% else %}{{ p.text }}{% endif %}</p>
        {%- endfor %}
        {%- if b.bullets %}<div style="margin-top:16px;">{{ bullets(b.bullets) }}</div>{% endif %}
        {%- for p in b.paragraphs_after %}
        <p style="margin-top:20px;">{{ p.text }}</p>
        {%- endfor %}
        {%- if b.callout %}
        <div class="callout-block" style="margin-top:32px;">
          <h3>{{ b.callout.h3 }}</h3>
          <p>{{ b.callout.text }}</p>
        </div>
        {%- endif %}
      </div>
      {%- if b.image_side != 'left' %}
      {%- if b.image %}<div class="two-col-img"><img src="{{ b.image }}" alt="{{ b.image_alt }}" loading="lazy" /></div>{% endif %}
      {%- endif %}
    </div>
  </section>
{%- elif b.type == 'cote' %}
  <section class="container" id="{{ b.id }}" aria-labelledby="{{ b.id }}-h2">
    <div class="cote-section">
      {%- if b.image %}<div class="cote-bg" aria-hidden="true"><img src="{{ b.image }}" alt="" loading="lazy" /></div>{% endif %}
      <div class="cote-content">
        <div class="section-tag">{{ b.tag }}</div>
        <h2 id="{{ b.id }}-h2">{{ b.h2 }}</h2>
        {%- for p in b.paragraphs %}<p>{{ p }}</p>{% endfor %}
        {%- if b.bullets %}<div style="margin-top:12px;">{{ bullets(b.bullets) }}</div>{% endif %}
      </div>
    </div>
  </section>
{%- elif b.type == 'etapes' %}
  <section class="container" id="{{ b.id }}" aria-labelledby="{{ b.id }}-h2">
    <div class="etapes-wrap {{ 'dark' if b.dark else 'light' }}">
      <div class="etapes-head">
        <div class="section-tag">{{ b.tag }}</div>
        <h2 id="{{ b.id }}-h2">{{ b.h2 }}</h2>
      </div>
      <div class="etapes-grid">
        {%- for s in b.steps %}
        <div class="etape-card" id="etape-{{ loop.index }}">
          {%- if s.bg %}<div class="etape-card-bg" aria-hidden="true"><img src="{{ s.bg }}" alt="" loading="lazy" /></div>{% endif %}
          <div class="etape-card-content">
            <div class="etape-num" aria-hidden="true">{{ '%02d.'|format(loop.index) }}</div>
            <h3>{{ s.h3 }}</h3>
            {%- for p in s.paragraphs %}<p>{{ p }}</p>{% endfor %}
            {%- if s.pill %}<span class="etape-pill">{{ s.pill }}</span>{% endif %}
          </div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>
{%- elif b.type == 'comparatif' %}
  <section class="container" id="{{ b.id }}" aria-labelledby="{{ b.id }}-h2">
    <div class="securite-wrap">
      <div class="securite-content">
        <div class="section-tag">{{ b.tag }}</div>
        <h2 id="{{ b.id }}-h2">{{ b.h2 }}</h2>
        <div class="compare-col">
          <span class="compare-label negative">{{ b.col_negative.label }}</span>
          <ul class="compare-list">
            {%- for i in b.col_negative['items'] %}<li class="compare-item"><span class="check-dot muted" aria-hidden="true"></span><span>{{ i }}</span></li>{% endfor %}
          </ul>
        </div>
        <div class="compare-col">
          <span class="compare-label positive">{{ b.col_positive.label }}</span>
          <ul class="compare-list">
            {%- for i in b.col_positive['items'] %}<li class="compare-item"><span class="check-dot" aria-hidden="true"></span><span>{{ i }}</span></li>{% endfor %}
          </ul>
        </div>
        <p class="securite-closing">{{ b.closing }}</p>
      </div>
      {%- if b.image %}<div class="securite-visual"><img src="{{ b.image }}" alt="{{ b.image_alt }}" loading="lazy" /></div>{% endif %}
    </div>
  </section>
{%- elif b.type == 'faq' %}
  <section class="container" id="{{ b.id }}" aria-labelledby="{{ b.id }}-h2">
    <div style="text-align:center;margin-bottom:48px;">
      <div class="section-tag" style="margin-left:auto;margin-right:auto;">{{ b.tag }}</div>
      <h2 id="{{ b.id }}-h2">{{ b.h2 }}</h2>
    </div>
    <div class="faq-grid">
      {%- for it in b['items'] %}
      <div class="callout-block">
        <h3>{{ it.q }}</h3>
        {%- for p in it.paragraphs %}<p>{{ p }}</p>{% endfor %}
        {%- if it.bullets %}<div style="margin-top:12px;">{{ bullets(it.bullets) }}</div>{% endif %}
        {%- for p in it.paragraphs_after %}<p style="margin-top:14px;">{{ p }}</p>{% endfor %}
      </div>
      {%- endfor %}
    </div>
  </section>
{%- endif %}
{%- endfor %}

  <section class="container" style="padding-bottom:96px;">
    <div class="cta-final">
      <div class="section-tag">{{ page.cta_final.tag }}</div>
      <h2>{{ page.cta_final.h2 }}</h2>
      <p style="max-width:520px;margin:0 auto;">{{ page.cta_final.lead }}</p>
      <a href="{{ page.cta_final.cta_href }}" class="btn-primary">{{ page.cta_final.cta_label }}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </section>

</main>

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div>
        <div class="footer-brand"><img src="{{ page.header.logo }}" alt="{{ page.header.logo_alt }}" /></div>
        <p class="footer-tagline">{{ page.footer.tagline }}</p>
        <div class="footer-social">
          {%- for s in page.footer.social %}
          <a href="{{ s.href }}" aria-label="{{ social_labels.get(s.network, s.network) }}">{{ social(s.network) }}</a>
          {%- endfor %}
        </div>
      </div>
      {%- for col in page.footer.columns %}
      <div>
        <div class="footer-col-title">{{ col.title }}</div>
        <div class="footer-links">
          {%- for l in col.links %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor %}
        </div>
      </div>
      {%- endfor %}
    </div>
    <div class="footer-legal"><p>{{ page.footer.legal }}</p></div>
    {%- if page.footer.eco and not page.footer.eco.startswith('TODO') %}<div class="footer-eco">{{ page.footer.eco }}{%- if page.footer.eco_link_href and page.footer.eco_link_label and not page.footer.eco_link_href.startswith('TODO') and not page.footer.eco_link_label.startswith('TODO') %} <a href="{{ page.footer.eco_link_href }}">{{ page.footer.eco_link_label }}</a>{%- endif %}</div>{%- endif %}
    <div class="footer-year">{{ page.footer.year }}</div>
  </div>
</footer>

</body>
</html>
