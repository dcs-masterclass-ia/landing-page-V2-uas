      "niveau_v1": "div",
      "titre_absent_en_v1": true,
      "paragraphs": [
        {
          "text": "FIAT PROFESSIONAL vous permet d’évaluer votre véhicule sur la base d’observations du marché et des transactions récentes, par un professionnel de l’automobile, le tout gratuitement et sans engagement."
        }
      ],
      "bullets": [],
      "image": "https://usine-a-sites.s3.amazonaws.com/141/254abc8e-b3e4-4da3-b47d-4be5f07c417b",
