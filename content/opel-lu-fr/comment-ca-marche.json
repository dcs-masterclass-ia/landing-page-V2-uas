  "blocks": [
    {
      "type": "two_col",
      "id": "opel-reprise",
      "h2": "Opel Reprise",
      "niveau_v1": "h3",
      "titre_absent_en_v1": false,
      "paragraphs": [
        {
          "text": "OPEL REPRISE est un service en ligne qui vous permet d'obtenir gratuitement une estimation de reprise de votre voiture. Vous renseignez les détails et l'état de votre voiture et vous recevrez une estimation de reprise par email.Lorsque vous faites une demande d'estimation en ligne, vous choisissez votre point de vente Opel le plus proche de chez vous. C'est un expert Opel du point de vente sélectionné qui vous contactera pour convenir d'un rendez-vous.Lors du rendez-vous, l'un de nos experts examine, en votre présence l'état de votre voiture. Une fois votre accord confirmé, nous nous engageons à une reprise immédiate. Le paiement est garanti, sécurisé et assuré par un point de vente OPEL."
        }
      ],
      "bullets": [],
      "image": "https://www.reprise.opel.lu/build/img/opel/content-serenity.jpg",
