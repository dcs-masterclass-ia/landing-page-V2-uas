      "paragraphs": [
        {
          "text": "Lorsque vous faites une demande d'estimation en ligne, nous vous invitons à sélectionner le DS STORE de votre choix. Vous serez contacté par un expert du point de vente sélectionné pour convenir d'un rendez-vous."
        }
      ],
      "bullets": [],
      "image": "https://reprise.dsautomobiles.be/build/img/ds/DS_3_CROSSBACK_XXL16-92x.png",
